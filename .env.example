APP_NAME=JogjaTrip
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jogjatrip
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): set true agar cookie sesi & trusted-device hanya dikirim lewat HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Dengan Redis: CACHE_STORE=failover dan CACHE_FAILOVER_STORES=redis,database
# (otomatis kembali ke database bila Redis mati).
CACHE_FAILOVER_STORES=database,array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production: ganti MAIL_MAILER (smtp/resend/mailgun) + kredensial provider, dan pakai MAIL_FROM_ADDRESS di domain sendiri.
# Notifikasi keamanan 2FA dikirim lewat queue, jadi `php artisan queue:work` harus berjalan.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Batas waktu total semua percobaan AI (detik) dan per percobaan (detik).
GEMINI_TIME_BUDGET=50
GEMINI_ATTEMPT_TIMEOUT=20

# --- Availability ---
# Backup database harian (php artisan app:backup-database, jadwal 02:00),
# diverifikasi lalu ditulis ke SEMUA disk berikut (pisahkan koma):
#   local = storage/app/private, offsite = BACKUP_OFFSITE_ROOT (mount NFS /
#   disk lain), s3 = butuh paket league/flysystem-aws-s3-v3.
BACKUP_DISKS=local
# BACKUP_OFFSITE_ROOT=/mnt/backup-jogjatrip
BACKUP_KEEP_DAYS=14
# Token untuk melihat detail GET /health (uptime monitor). Kosong = ringkas saja.
HEALTH_TOKEN=
# Email yang menerima peringatan otomatis saat sistem bermasalah / pulih.
HEALTH_ALERT_EMAIL=
HEALTH_ALERT_COOLDOWN=30

# --- Resilience ---
# Circuit breaker: setelah N kegagalan beruntun, layanan "diistirahatkan"
# selama COOLDOWN detik (permintaan langsung memakai jalur cadangan).
BREAKER_GEMINI_THRESHOLD=3
BREAKER_GEMINI_COOLDOWN=120
BREAKER_WEATHER_THRESHOLD=3
BREAKER_WEATHER_COOLDOWN=300
# Percobaan ulang transaksi database saat deadlock.
DB_TRANSACTION_ATTEMPTS=3
# MAIL_MAILER=failover -> coba mailer berurutan bila yang pertama gagal.
MAIL_FAILOVER_MAILERS=smtp,log
# Gagal cepat bila database tidak menjawab (detik).
DB_CONNECT_TIMEOUT=5
# Opsional: host replika baca MySQL (pisahkan koma).
# DB_READ_HOST=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

AUTH_IDLE_TIMEOUT=120

VITE_APP_NAME="${APP_NAME}"
