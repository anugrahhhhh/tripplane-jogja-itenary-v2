server {
    listen __PORT__;
    server_name _;
    root /var/www/html/public;
    index index.php;

    client_max_body_size 20M;

    # Responsiveness: kompres respons teks (HTML/CSS/JS/JSON/SVG).
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml;

    # Laravel (SecurityHeaders middleware) juga mengirim header ini; versi
    # dari PHP disembunyikan di blok .php agar tidak terkirim dobel.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 180;
        fastcgi_hide_header X-Frame-Options;
        fastcgi_hide_header X-Content-Type-Options;
        fastcgi_hide_header Referrer-Policy;
    }

    # PHP-FPM mati/restart -> halaman statis ramah, bukan "502 Bad Gateway".
    error_page 502 504 /fallback.html;
    location = /fallback.html {
        root /usr/share/nginx/fallback;
        internal;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "20" always;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    # Aset hasil Vite punya hash di nama file, jadi aman di-cache selamanya.
    location /build/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
        try_files $uri =404;
    }

    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|webp|woff|woff2)$ {
        expires 7d;
        access_log off;
    }
}
